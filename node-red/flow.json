[
  {
    "id": "nexaline.tab",
    "type": "tab",
    "label": "NEXALINE - Producao",
    "disabled": false,
    "info": "Flow de simulacao e testes para o sistema NEXALINE.\n\nTopico: producao/eventos\nEvento: pieceProduced (pulso unico por peca)"
  },
  {
    "id": "nexaline.broker",
    "type": "mqtt-broker",
    "name": "Broker Local",
    "broker": "localhost",
    "port": "1883",
    "clientid": "node-red-nexaline",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "nexaline.inject.start",
    "type": "inject",
    "z": "nexaline.tab",
    "name": "TESTE - Sinal Unico",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "topic": "",
    "payload": "pieceProduced",
    "payloadType": "str",
    "x": 190,
    "y": 160,
    "wires": [["nexaline.fn.build"]]
  },
  {
    "id": "nexaline.fn.build",
    "type": "function",
    "z": "nexaline.tab",
    "name": "Montar Evento",
    "func": "const EVENT = 'pieceProduced';\nconst name = typeof msg.payload === 'string' ? msg.payload : msg.payload && msg.payload.event;\n\nif (name !== EVENT) {\n    node.warn('Pulso invalido: ' + name);\n    return null;\n}\n\nmsg.topic = 'producao/eventos';\nmsg.payload = { event: EVENT, ts: Date.now() };\nnode.status({ fill: 'green', shape: 'dot', text: 'pulso de producao' });\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 470,
    "y": 160,
    "wires": [["nexaline.mqtt.out", "nexaline.debug"]]
  },
  {
    "id": "nexaline.mqtt.out",
    "type": "mqtt out",
    "z": "nexaline.tab",
    "name": "MQTT Out - producao/eventos",
    "topic": "producao/eventos",
    "qos": "0",
    "retain": "false",
    "respTopic": "",
    "contentType": "application/json",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "nexaline.broker",
    "x": 810,
    "y": 250,
    "wires": []
  },
  {
    "id": "nexaline.debug",
    "type": "debug",
    "z": "nexaline.tab",
    "name": "Eventos Publicados",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 810,
    "y": 330,
    "wires": []
  }
]
